    "employee_wise": [
      "Join each entity row to an employee by assigned_to, assigned_to_name, employee_id, employee_name, empid, or emp_id.",
      "Join employee to team by department_name first, then department, then manager/project fallback.",
      "Group by employee_id and employee_name.",
      "Calculate task, issue, release, ticket, and DSR metrics independently before combining into one employee KPI row."
    ],
    "team_wise": [
      "Build team membership from team_members and employees.",
      "Group employee_wise rows by team_name.",
      "Sum counts and recompute rates from summed numerator and denominator values."
    ],
    "date_wise": [
      "Normalize all dates to YYYY-MM-DD.",
      "Tasks and issues can contribute to start_date and due-date charts.",
      "Releases can contribute to planned_date, released_date, and overdue charts.",
      "Tickets contribute by created_date.",
      "DSR contributes by date."
    ],
