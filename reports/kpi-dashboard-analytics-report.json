  "kpi_definitions": {
    "total_count": "count(rows)",
    "completion_rate_percent": "round(completed_count / total_count * 100, 2). Return null when total_count is 0 or unavailable.",
    "pending_rate_percent": "round(pending_count / total_count * 100, 2). Return null when total_count is 0 or unavailable.",
    "failure_rate_percent": "round(failed_count / total_count * 100, 2). Return null when total_count is 0 or unavailable.",
    "average_completion_percent": "round(avg(completion_percentage), 2) using rows where completion_percentage is numeric.",
    "overdue_count": "count(rows where end_date or released_date is before report_date and status is not completed)",
    "on_time_release_rate_percent": "round(on_time_release_count / completed_release_count * 100, 2), where released_date <= planned_date for non-upcoming completed releases.",
    "dsr_submission_rate_percent": "round(submitted_employee_days / expected_employee_days * 100, 2)",
