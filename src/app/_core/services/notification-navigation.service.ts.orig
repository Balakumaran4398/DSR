import { Injectable } from '@angular/core';
import { BehaviorSubject } from 'rxjs';

export type NotificationNavigationCategory = 'issue' | 'release' | 'ticket' | 'not-send-dsr';

export interface NotificationNavigationContext {
  category: NotificationNavigationCategory;
  targetId: string | null;
  projectId: string | null;
  startDate: string | null;
  endDate: string | null;
  targetDate?: string | null;
  targetLabel?: string | null;
  createdAt: number;
}

@Injectable({ providedIn: 'root' })
export class NotificationNavigationService {
  private readonly storageKey = 'notificationNavigationContext';
  private readonly maxAgeMs = 30 * 60 * 1000;
  private readonly contextSubject = new BehaviorSubject<NotificationNavigationContext | null>(this.readStored());

  readonly context60 this.contextSubject.asObservable();

  get currentContext(): NotificationNavigationContext | null {
    return this.contextSubject.value;
  }

  create(
    category: NotificationNavigationCategory,
    targetId: unknown,
    projectId: unknown,
    startDate: string | null,
    endDate: string | null,
    targetDate?: string | null,
    targetLabel?: unknown
  ): NotificationNavigationContext {
    return {
      category,
      targetId: this.normalizeId(targetId),
      projectId: this.normalizeId(projectId),
      startDate: this.validDate(startDate) ? startDate : null,
      endDate: this.validDate(endDate) ? endDate : null,
      targetDate: this.normalizeDate(targetDate),
      targetLabel: this.normalizeId(targetLabel),
      createdAt: Date.now()
    };
  }

  store(context: NotificationNavigationContext): void {
    sessionStorage.setItem(this.storageKey, JSON.stringify(context));
    this.contextSubject.next(context);
  }

  navigationState(context: NotificationNavigationContext): Record<string, NotificationNavigationContext> {
    return { notificationContext: context };
  }

  resolve(category: NotificationNavigationCategory, targetId?: unknown, projectId?: unknown): NotificationNavigationContext | null {
    const historyContext = typeof history !== 'undefined'
      ? (history.state?.notificationContext as NotificationNavigationContext | undefined)
      : undefined;
    const currentContext = this.validate(this.contextSubject.value);
    const context = currentContext || this.validate(historyContext) || this.readStored();
    if (!context || context.category !== category) return null;

    const expectedTarget = this.normalizeId(targetId);
    const expectedProject = this.normalizeId(projectId);
    if (expectedTarget && context.targetId !== expectedTarget) return null;
    if (expectedProject && context.projectId !== expectedProject) return null;
    return context;
  }

  private readStored(): NotificationNavigationContext | null {
    try {
      const raw = sessionStorage.getItem(this.storageKey);
      return raw ? this.validate(JSON.parse(raw)) : null;
    } catch {
      return null;
    }
  }

  private validate(value: any): NotificationNavigationContext | null {
    const categories: NotificationNavigationCategory[] = ['issue', 'release', 'ticket', 'not-send-dsr'];
    if (!value || !categories.includes(value.category) || !Number.isFinite(value.createdAt)) return null;
    if (Date.now() - value.createdAt > this.maxAgeMs) return null;
    if (value.startDate && !this.validDate(value.startDate)) return null;
    if (value.endDate && !this.validDate(value.endDate)) return null;
    return value as NotificationNavigationContext;
  }

  private normalizeId(value: unknown): string | null {
    if (value === null || value === undefined) return null;
    const normalized = `${value}`.trim();
    return normalized ? normalized : null;
  }

  private normalizeDate(value: unknown): string | null {
    if (!value) return null;
    const raw = String(value).trim();
    const direct = raw.match(/^\d{4}-\d{2}-\d{2}/)?.[0];
    if (direct && this.validDate(direct)) return direct;
    const date = new Date(raw);
    if (Number.isNaN(date.getTime())) return null;
    return date.getFullYear() + '-'
      + String(date.getMonth() + 1).padStart(2, '0') + '-'
      + String(date.getDate()).padStart(2, '0');
  }

  private validDate(value: unknown): value is string {
    if (typeof value !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
    return !Number.isNaN(new Date(`${value}T00:00:00`).getTime());
  }
}
